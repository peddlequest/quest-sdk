{
  "name": "@peddlequest/sdk",
  "version": "0.2.0",
  "description": "Typed client for the PeddleQuest public API, the PeddleQuest escrow contracts, winner-list verification and the quest, leaderboard and live-quests widgets.",
  "license": "MIT",
  "author": "Gully Labs LLC <team@gullylabs.xyz>",
  "homepage": "https://docs.peddlequest.xyz/integrations/sdk",
  "keywords": [
    "peddlequest",
    "quests",
    "escrow",
    "merkle",
    "viem"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PROMPT.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "abis": "node scripts/extract-abis.mjs",
    "abis:check": "node scripts/extract-abis.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "viem": "^2.37.0",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peddlequest/quest-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/peddlequest/quest-sdk/issues"
  }
}
